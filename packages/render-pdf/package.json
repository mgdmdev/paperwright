{
  "name": "@paperwright/render-pdf",
  "version": "0.0.0",
  "description": "Render a docform document model to PDF through an engine adapter (Forme, Takumi)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@paperwright/model": "workspace:*",
    "@paperwright/react": "workspace:*",
    "@formepdf/core": "0.20.0",
    "@formepdf/react": "0.20.0",
    "takumi-pdf": "0.14.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@takumi-rs/helpers": "2.13.6",
    "react": "^19.2.8",
    "takumi-pdf-011": "npm:takumi-pdf@0.11.0"
  }
}
