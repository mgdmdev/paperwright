{
  "name": "@paperwright/pdf",
  "version": "0.1.0",
  "description": "Renders a paperwright document model to PDF: the Forme engine, the component layer and themes, bundled Inter",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "fonts", "README.md", "LICENSE", "NOTICE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@formepdf/core": "0.20.0",
    "@formepdf/react": "0.20.0",
    "@paperwright/model": "workspace:*",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "react": "^19.2.8"
  },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/mgdmdev/paperwright.git", "directory": "packages/pdf" },
  "homepage": "https://github.com/mgdmdev/paperwright/tree/main/packages/pdf#readme",
  "bugs": "https://github.com/mgdmdev/paperwright/issues",
  "keywords": ["pdf", "document", "template", "react", "forme", "pdfcn"]
}
