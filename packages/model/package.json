{
  "name": "@paperwright/model",
  "version": "0.0.0",
  "description": "The paperwright document model: types, schema, binding evaluator, migrations",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgdmdev/paperwright.git",
    "directory": "packages/model"
  },
  "homepage": "https://github.com/mgdmdev/paperwright/tree/main/packages/model#readme",
  "bugs": "https://github.com/mgdmdev/paperwright/issues",
  "keywords": [
    "pdf",
    "document",
    "template",
    "react",
    "forme",
    "takumi",
    "pdfcn"
  ]
}
